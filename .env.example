# ===== Обязательные =====
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ===== Дополнительно =====
# ID администратора/владельца (можно несколько через запятую) — кому доступен бот
ADMIN_IDS=123456789

# Только администраторы могут пользоваться ботом (true/false)
RESTRICT_TO_ADMINS=false

# Кодировка вывода CLI-инструментов (проблемы с кириллицей в консоли Windows)
CLI_ENCODING=utf-8

# Таймаут для CLI-инструментов (сек)
CLI_TIMEOUT=90

# ===== PhoneInfoga (бинарник) =====
# Полный путь к бинарнику phoneinfoga.exe / phoneinfoga
# Скачать: https://github.com/ExpertAnonymous/PhoneInfoga/releases
PHONEINFOGA_PATH=
PHONEINFOGA_API_KEY=

# ===== Telegram (Telethon) =====
# API ID и API Hash для Telegram (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=
# JSON-пара «phone:session» для переиспользования сессии Telethon, например:
# {"+375291234567": "session_1.session"}
TG_ACCOUNTS=

# ===== GHunt =====
# GHunt требует авторизации. Запустите в консоли:  ghunt check   (один раз, ~/.pyconfig/ghunt/)
# После этого можно оставить пустым.
GHUNT_CONFIG_PATH=

# ===== Sherlock =====
# Кол-во сайтов-путей для получения (опция --officially-verified)
SHERLOCK_OFFICIALLY_VERIFIED=false

# ===== Webhook (вместо long-polling) =====
# Нужен ТОЛЬКО для нескольких реплик/авто-масштабирования (docker compose --scale).
# Обычный запуск работает и без него. Домен должен вести на HTTPS и быть доступен из интернета.
# WEBHOOK_DOMAIN=https://bot.example.com
# WEBHOOK_PATH=/webhook/probivbot
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET=случайная_строка_для_подписи_запросов
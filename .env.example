# ===== Обязательные =====
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ===== Дополнительно =====
# ID администратора/владельца (можно несколько через запятую) — кому доступен бот
ADMIN_IDS=123456789

# Только администраторы могут пользоваться ботом (true/false)
RESTRICT_TO_ADMINS=true

# Кодировка вывода CLI-инструментов (проблемы с кириллицей в консоли Windows)
CLI_ENCODING=utf-8

# Таймаут для CLI-инструментов (сек)
CLI_TIMEOUT=90

# ===== PhoneInfoga (бинарник) =====
# Полный путь к бинарнику phoneinfoga.exe / phoneinfoga
# Скачать: https://github.com/ExpertAnonymous/PhoneInfoga/releases
PHONEINFOGA_PATH=
PHONEINFOGA_API_KEY=

# ===== Telegram (Telethon) =====
# API ID и API Hash для Telegram (https://my.telegram.org/apps) — бесплатно
TG_API_ID=
TG_API_HASH=
# JSON-пары «phone:session» для переиспользования сессий Telethon. Можно
# несколько — бот перебирает их ПО ОЧЕРЕДИ (первая, кто ответит, и результат).
# Пример:
#   {"+375291234567": "sess_1", "+79001234567": "sess_2"}
# Сессию создаёт скрипт:  python session_maker.py   (войдёт по коду в Telegram)
# Файлы .session лежат в data/telegram_sessions/
TG_ACCOUNTS=

# ===== GHunt =====
# GHunt требует авторизации. Запустите в консоли:  ghunt check   (один раз, ~/.pyconfig/ghunt/)
# После этого можно оставить пустым.
GHUNT_CONFIG_PATH=

# ===== Sherlock =====
# Кол-во сайтов-путей для получения (опция --officially-verified)
SHERLOCK_OFFICIALLY_VERIFIED=false

# ===== Проверка аккаунтов в соцсетях (по email/телефону/нику) =====
# Через какие сервисы проверять (через запятую). Пусто = все.
# Доступно: instagram, tiktok, vk, whatsapp, telegram, github
# Важно: у Instagram/TikTok/VK/WhatsApp НЕТ публичных API-ключей для проверки
# «есть ли аккаунт» — бот идёт по их формам регистрации через curl_cffi
# (подделка TLS-отпечатка Chrome). Если сайт защищён от ботов — будет
# «⚠️ не удалось проверить» (это честный ответ, а не баг).
# REG_SERVICES=instagram,tiktok,vk,whatsapp,telegram,github

# ===== Webhook (вместо long-polling) =====
# Нужен ТОЛЬКО для нескольких реплик/авто-масштабирования (docker compose --scale).
# Обычный запуск работает и без него. Домен должен вести на HTTPS и быть доступен из интернета.
# WEBHOOK_DOMAIN=https://bot.example.com
# WEBHOOK_PATH=/webhook/probivbot
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET=случайная_строка_для_подписи_запросов
